# MailDesk Mobile - Supabase Edge Function secrets.
# Configure these values in Supabase > Edge Functions > Secrets.
# SUPABASE_URL / SUPABASE_ANON_KEY are provided automatically by Supabase.

RESEND_API_KEY=re_...
RESEND_FROM=contact@your-domain.example
RESEND_WEBHOOK_SECRET=whsec_...

# Configure the Resend webhook on:
# https://YOUR_PROJECT.supabase.co/functions/v1/maildesk-api/webhooks/resend
# Event: email.received

# Optional fallback allowlists.
# Accounts created/linked from MailDesk Desktop receive app_metadata.maildesk_access=true automatically.
# MAILDESK_MOBILE_ALLOWED_EMAILS=you@your-domain.example
# MAILDESK_MOBILE_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000

# Optional mobile signature. Data/base64 images are converted to inline CID at send time.
# MAILDESK_MOBILE_SIGNATURE_HTML=<div>Cordialement...</div>

# The mobile API URL is derived automatically:
# https://YOUR_PROJECT.supabase.co/functions/v1/maildesk-api
